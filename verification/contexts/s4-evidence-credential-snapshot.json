{
  "schema_version": "test-context/v1",
  "id": "sprintctl.s4.evidence-credential-snapshot",
  "owner_repo": "sprintctl",
  "subject": "one-authenticated-identity-per-native-evidence-sync-pass",
  "contract_ref": {
    "doc_id": "s4-native-evidence-intake",
    "revision": "git:eaf52989a1aaf7dd0847a39ce4c2b495de1dfa96; October9 credential snapshot prerequisite"
  },
  "source_of_truth": "credential resolved once into transient invoker closure; native owner retains evidence authority",
  "depth": 1,
  "backends": [
    "stub-async-client",
    "temporary-sqlite-producer"
  ],
  "actors": [
    "producer",
    "credential-replacer",
    "authenticated-native-client"
  ],
  "initial_state": [
    "registered run binding",
    "configured credential reference"
  ],
  "operations": [
    {
      "name": "resolve-run",
      "actors": [
        "producer"
      ]
    },
    {
      "name": "replace-credential",
      "actors": [
        "credential-replacer"
      ]
    },
    {
      "name": "append-evidence",
      "actors": [
        "producer"
      ]
    },
    {
      "name": "revoke-original",
      "actors": [
        "credential-replacer"
      ]
    },
    {
      "name": "new-pass",
      "actors": [
        "producer"
      ]
    }
  ],
  "consistency": {
    "target": "application-invariant",
    "object": "pass-authentication-snapshot"
  },
  "assumptions": {
    "isolation": "real facade coroutines and fresh stub clients, no deployed HTTP fault injection",
    "clock": "revocation simulated by typed refusal"
  },
  "bounds": {
    "production_mutation": false,
    "depth": 1
  },
  "invariants": [
    "one credential resolution per nonempty pass",
    "new pass may adopt replacement",
    "refusal does not switch identity",
    "unrelated operations rejected before RPC"
  ],
  "faults": [
    "credential replacement after resolution",
    "original credential revoked before append"
  ],
  "oracles": [
    "credential resolution count",
    "authenticated token sequence",
    "typed refusal propagation",
    "client identity and scope checks"
  ],
  "implementation_anchors": [
    "sprintctl/served.py::native_evidence_invoker",
    "sprintctl/commands/operations.py::evidence_sync",
    "tests/test_native_evidence_intake.py"
  ],
  "expansions": [
    "semantic-doc",
    "stateful-test",
    "fault-scenario"
  ]
}
