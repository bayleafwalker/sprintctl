  },
  "source_of_truth": "native PostgreSQL reservations, immutable Release and scoped replay ledger; producer rows hold intent and correlated receipts only",
  "depth": 2,
  "backends": [
    "temporary-sqlite-producer",
    "disposable-postgresql-16"
  ],
  "actors": [
    "offline-producer",
    "second-producer",
    "native-work-authority"
  ],
  "initial_state": [
    "registered-run",
    "observed-full-release-basis",
    "empty-producer-reserve-intake"
  ],
  "operations": [
    {
      "name": "offline-capture",
      "actors": [
        "offline-producer",
        "native-work-authority"
      ]
    },
    {
      "name": "read-only-status",
      "actors": [
        "offline-producer",
        "native-work-authority"
      ]
    },
    {
      "name": "run-resolution",
      "actors": [
        "offline-producer",
        "native-work-authority"
      ]
    },
    {
      "name": "native-reserve",
      "actors": [
        "offline-producer",
        "native-work-authority"
      ]
    },
    {
      "name": "read-frozen-release",
      "actors": [
        "offline-producer",
        "native-work-authority"
      ]
    },
    {
      "name": "exact-replay",
      "actors": [
        "offline-producer",
        "native-work-authority"
      ]
    }
  ],
  "consistency": {
    "target": "application-invariant",
    "object": "native-reserve-key-and-producer-confirmation"
  },
  "assumptions": {
    "isolation": "temporary SQLite with file-locked carrier; real disposable PG16 owner, independent race connections; no deployed HTTP authentication",
    "clock": "no expiry-dependent lifecycle semantics exercised"
  },
  "bounds": {
    "new_pg_histories": 21,
    "new_unit_cases": 32,
    "independent_connection_races": 1
  },
  "invariants": [
    "offline intent has no effective reserve or Release authority",
    "exact owner-key replay retains one reserve effect",
    "current mutable lifecycle fields remain separate from immutable admission",
    "uncorrelated or damaged receipts never hide pending intent",
    "stale head stops later reserve requests",
    "batch observation sync never invokes reserve"
  ],
  "faults": [
    "commit-before-reply-loss",
    "stale-release-basis",
    "changed-caller-or-binding",
    "unrelated-row-or-snapshot",
    "invalid-overlap",
    "unrelated-release",
    "wrong-release-content-digest",
    "lost-release-read-reply",
    "damaged-confirmation",
    "reassignment-and-release-before-replay",
    "two-producer-contention"
  ],
  "oracles": [
    "native reservation/event/key/Release counts",
    "original-byte and digest comparisons",
    "pending IDs and immutable receipt identity",
    "two independent connections synchronized before admission retain one effect"
  ],
  "implementation_anchors": [
    "sprintctl/reserve_intake.py::capture",
    "sprintctl/reserve_intake.py::synchronize",
    "sprintctl/reserve_intake.py::_validate_history",
    "tests/pg/test_native_reserve_intake.py"
  ],
  "expansions": [
    "semantic-doc",
    "stateful-test",
    "concurrent-history",
    "fault-scenario"
  ]
}
