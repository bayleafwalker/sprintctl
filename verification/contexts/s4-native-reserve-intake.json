{
  "schema_version": "test-context/v1",
  "id": "sprintctl.s4.native-reserve-intake",
  "owner_repo": "sprintctl",
  "subject": "durable-native-reserve-intent-and-correlated-replay",
  "contract_ref": {
    "doc_id": "s4-native-reserve-intake",
