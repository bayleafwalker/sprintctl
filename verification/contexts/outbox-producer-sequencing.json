{
  "schema_version": "test-context/v1",
  "id": "sprintctl.outbox.producer-sequencing",
  "owner_repo": "sprintctl",
  "subject": "producer-authored-observation-and-authority-command-outbox",
  "contract_ref": {
    "doc_id": "adr-outbox-sync-model",
    "revision": "git:50cf3ee13009b04fc0e61db5d5be6f4f6bcbf215"
  },
  "source_of_truth": "local-producer-sqlite-outbox",
  "depth": 2,
  "backends": ["sqlite"],
  "actors": ["producer-a", "producer-b", "legacy-migration-opener-a", "legacy-migration-opener-b"],
  "initial_state": ["outbox-empty", "origin-stream-unminted", "legacy-observation-only-outbox"],
  "operations": [
    {"name": "append-observation", "actors": ["producer-a", "producer-b"], "synchronization": "bounded concurrent writers"},
    {"name": "open-migrate-and-append", "actors": ["legacy-migration-opener-a", "legacy-migration-opener-b"], "synchronization": "barrier-before-independent-connections-initialize-wal"},
    {"name": "retry-after-lost-local-response", "actors": ["producer-a"]},
    {"name": "reopen-after-committed-append", "actors": ["producer-a"]}
  ],
  "consistency": {
    "target": "application-invariant",
    "object": "single-producer-stream-sequence"
  },
  "assumptions": {
    "isolation": "SQLite BEGIN IMMEDIATE writer serialization",
    "clock": "producer process UTC clock",
    "fairness": "SQLite lock acquisition eventually succeeds within connection timeout"
  },
  "bounds": {"writers": 2, "appends_per_writer": 12, "concurrent_legacy_migration_histories": 32, "wal_initialization_attempts": 5, "wal_retry_delays_seconds": "0.01,0.02,0.04,0.08"},
  "invariants": [
    "committed-observations-survive-producer-restart",
    "origin-sequences-are-contiguous-within-the-stream",
    "same-event-id-does-not-consume-an-additional-sequence",
    "failed-insert-does-not-mint-a-visible-stream-or-consume-a-sequence",
    "outbox-records-are-immutable",
    "bounded-busy-or-locked-wal-initialization-does-not-discard-a-legacy-row-or-concurrent-append",
    "failed-wal-initialization-connections-are-closed",
    "non-busy-wal-initialization-errors-propagate-without-retry"
  ],
  "faults": [
    "insert-failure-before-commit",
    "sqlite-busy-or-locked-during-concurrent-wal-initialization",
    "lost-response-after-local-commit",
    "producer-restart-after-local-commit"
  ],
  "oracles": [
    "outbox-record-query",
    "concurrent legacy migration records retain the legacy event first and have origin_seq exactly [1, 2, 3]",
    "stream-sequence-contiguity",
    "immutable-trigger-check"
  ],
  "implementation_anchors": [
    "sprintctl/outbox.py:_is_busy_or_locked",
    "sprintctl/outbox.py:open_outbox",
    "sprintctl/outbox.py:_initialize_schema_after_wal",
    "sprintctl/outbox.py:append_observation",
    "sprintctl/outbox.py:init_outbox"
  ],
  "expansions": ["stateful-test", "fault-scenario"]
}
