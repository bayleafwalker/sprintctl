    "producer-command-outbox-empty",
    "remote-authority-aggregate-at-known-basis",
    "remote-decision-ledger-empty"
  ],
  "operations": [
    {
      "name": "append-command-request",
      "actors": ["producer"],
      "synchronization": "SQLite BEGIN IMMEDIATE plus FULL synchronous commit"
    },
    {
      "name": "arbitrate-current-command",
      "actors": ["remote-authority"],
      "synchronization": "PostgreSQL aggregate row lock and one transaction"
    },
    {
      "name": "retry-identical-command",
      "actors": ["producer", "remote-authority"],
      "synchronization": "after accepted decision commit using identical stream identity"
    },
    {
      "name": "submit-stale-or-expired-command",
      "actors": ["producer", "competing-claim-owner", "remote-authority"],
      "synchronization": "after remote basis or claim grant advances"
    },
    {
      "name": "inject-decision-write-failure",
      "actors": ["remote-authority"],
      "synchronization": "before authority_decision insert in the effect transaction"
    }
  ],
  "consistency": {
    "target": "application-invariant",
    "object": "request-effect-decision-atomicity-and-claim-grant-safety"
  },
  "assumptions": {
    "isolation": "PostgreSQL READ COMMITTED with explicit aggregate row locks",
    "clock": "PostgreSQL transaction clock for claim expiry",
    "fairness": "none"
  },
  "bounds": {
    "producer_streams": 1,
    "remote_authorities": 1,
    "command_types": 9,
    "identical_retries": 1,
    "competing_claim_owners": 2,
    "injected_transaction_failures": 1
  },
  "invariants": [
