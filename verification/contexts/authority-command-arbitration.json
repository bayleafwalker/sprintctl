  "source_of_truth": "postgresql-authority-state-plus-immutable-ingest-ledger",
  "depth": 2,
  "backends": ["sqlite-producer-outbox", "postgresql-remote-authority"],
  "actors": ["producer", "remote-authority", "competing-claim-owner"],
  "initial_state": [
