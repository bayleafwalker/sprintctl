  "script_source": "from pathlib import Path\nimport tempfile,subprocess,hashlib,json,base64,re\nroot=Path('/tmp/sprintctl-locked-decision-2805')\nrows=json.loads(Path('/tmp/sprintctl-2805-staged-leaks-final.json').read_text())\nassert len(rows)==86\nfor row in rows:\n assert row['RuleID']=='generic-api-key'\n assert row['File'] in ['verification/fixtures/locked-decision-writing-before-histories-2805.json','verification/traces/locked-decision-writing-histories-2805.json']\n line=(root/row['File']).read_text().splitlines()[row['StartLine']-1]\n assert re.fullmatch(r'\\s*\"(?:claim_key|idempotency_key)\": \"direct-(?:settlement-)?[0-9a-f]{32}(?:-[ac])?\",',line)\nignore=root/'.gitleaksignore';s=ignore.read_text();fingerprints=sorted(r['Fingerprint'] for r in rows)\nassert not any(f in s for f in fingerprints)\nignore.write_text(s+'\\n# #2805 actual disposable-backend traces: synthetic advisory claim/idempotency IDs.\\n'+''.join(f+'\\n' for f in fingerprints))\nsynthetic=base64.b64encode(hashlib.sha256(b'2805 synthetic detector control').digest()).decode()\nresults=[]\nfor rel in sorted(set(r['File'] for r in rows)):\n row=next(r for r in rows if r['File']==rel);line=(root/rel).read_text().splitlines()[row['StartLine']-1]+'\\n'\n cases=[('exact-reviewed-synthetic-ID',rel,'\\n'*(row['StartLine']-1)+line,0),('same-synthetic-pattern-elsewhere','elsewhere.json',line,1),('credential-field-other-line-same-file',rel,'\"api_key\": \"'+synthetic+'\",\\n',1)]\n for name,path,content,expected in cases:\n  with tempfile.TemporaryDirectory(prefix='2805-detector-control-',dir='/tmp') as temp:\n   tmp=Path(temp);(tmp/'.gitleaksignore').write_bytes(ignore.read_bytes());p=tmp/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(content)\n   subprocess.run(['git','init','-q'],cwd=tmp,check=True);subprocess.run(['git','add','.'],cwd=tmp,check=True)\n   run=subprocess.run(['gitleaks','git','--staged','--redact','--no-banner'],cwd=tmp,capture_output=True,text=True)\n   assert run.returncode==expected,(name,run.returncode)\n   results.append({'case':name,'path':path,'expected_exit':expected,'actual_exit':run.returncode})\npacket={'classification':'86 reviewed synthetic disposable-test advisory claim/idempotency IDs, never bearer authority','fingerprints':fingerprints,'controls':results,'script_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'script_source':Path(__file__).read_text(),'ignore_sha256':hashlib.sha256(ignore.read_bytes()).hexdigest(),'limits':'Exact file/rule/line fingerprints are location-scoped, not content-bound. Future same-line edits need review; artifact byte hashes pin current reviewed content. Other lines and files remain scanned.'}\n(root/'verification/fixtures/locked-decision-writing-scanner-controls-2805.json').write_text(json.dumps(packet,indent=2)+'\\n')\nprint(json.dumps(results))\n",
