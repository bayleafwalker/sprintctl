{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprintctl.invalid/schemas/verified-run-invocation-metadata-v1.json",
  "title": "Verified run invocation transport metadata",
  "description": "Not an MCP argument schema. These values are accepted only from a verified gateway identity object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "attempt_id", "principal_epoch"],
  "properties": {
    "invocation_id": {"type": "string", "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"},
    "attempt_id": {"type": "string", "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"},
    "principal_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
