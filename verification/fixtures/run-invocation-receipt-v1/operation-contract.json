{
  "format": "sprintctl-versioned-operation-contract/v1",
  "contract": "sprintctl-run-invocation-receipt-contract/v1",
  "postgres_schema_version": 23,
  "sqlite_support": "unsupported",
  "operations": {
    "work.run.register-correlated-v1": {
      "request_schema": "register-correlated.schema.json",
      "authority": "work:evidence",
      "correlation_source": "verified-gateway-identity-metadata-only",
      "required_verified_metadata": ["invocation_id", "attempt_id", "principal_epoch"],
      "pair_rule": "both-ids-required-together",
      "missing_pair": "use-legacy-work.run.register-v1",
      "partial_pair": "typed-refusal-before-write",
      "ledger_tool": "register_run",
      "legacy_idempotency_and_result": "unchanged",
      "owner_acceptance_dependency": false
    },
    "work.run.invocation-receipt-get-v1": {
      "request_schema": "receipt-get.schema.json",
      "result_schema": "receipt-result.schema.json",
      "authority": "work:read",
      "repo_source": "explicit-selected-owner-repository-context",
      "identity_source": "current-verified-owner-identity",
      "requires_existing_owned_run": true,
      "lookup": "exact-invocation-and-attempt-pair-only",
      "enumeration": false,
      "foreign_or_unknown": "same-run-not-found-404"
    }
  },
  "identity_binding_fields": [
    "repo_id",
    "workspace_id",
    "principal_id",
    "principal_epoch",
    "client_id",
    "grant_id"
  ],
  "public_receipt_excludes": [
    "owner_request_digest",
    "idempotency_key",
    "run_arguments",
    "grant_ids",
    "claim_ids",
    "raw_tokens",
    "response_body"
  ],
  "transaction_rule": "verified-correlation-write-is-atomic-with-owner-register-and-ledger; technical-failure-rolls-back-and-is-retryable-unknown",
  "correlation_is_authority": false,
  "correlation_is_acceptance_evidence": false
}
