{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprintctl.invalid/schemas/work.run.register-correlated-v1.request.json",
  "title": "work.run.register-correlated-v1 request",
  "description": "Exact additive request shape of work.run.register-v1. Correlation IDs and epoch are verified transport metadata and are forbidden in MCP arguments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["harness_id", "harness_build", "model_id", "recipe_id", "observed_profile", "idempotency_key"],
  "properties": {
    "harness_id": {"type": "string", "minLength": 1},
    "harness_build": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "recipe_id": {"type": "string", "minLength": 1},
    "observed_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_digest", "skill_digests"],
      "properties": {
        "instruction_digest": {"type": "string", "minLength": 1},
        "skill_digests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill_id", "digest"],
            "properties": {
              "skill_id": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "predecessor_run_id": {"type": "string", "minLength": 1}
  }
}
