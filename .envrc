# sprintctl runs in served mode against the Vuoro work adapter (sprintctl
# #1195/#1223/#1226). Direct PostgreSQL credentials are no longer the default
# path; SPRINTCTL_BACKEND=remote plus SPRINTCTL_URL remain available below,
# commented, for rollback only -- see docs/plans/1164-gate-evidence-ledger.md.

export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
export SPRINTCTL_DB="$PWD/.sprintctl/sprintctl.db"

# Host-specific overrides (e.g. a different SPRINTCTL_VUORO_PROFILE on
# devbox-agent) belong in .envrc.local, which is gitignored and never
# committed. It is sourced last so it can override any export above.
source_env_if_exists .envrc.local

# Rollback path (direct PostgreSQL, pre-#1226): uncomment and flip
# .sprintctl/backend.json's "backend" back to "remote" if served mode is
# unavailable.
