{
  "schema_version": 1,
  "repo_id": "2be118eb-8e89-433a-8d32-ada157624f95",
  "adoption_level": "guidance-only",
  "routing": {
    "default_harness": "caller",
    "default_model_alias": "fast-build",
    "action_classes": {
      "plan": { "enabled": true, "model_alias": "frontier-plan" },
      "build": { "enabled": true, "model_alias": "fast-build", "review_required": true },
      "review": { "enabled": true, "model_alias": "review-synthesis" },
      "verify": { "enabled": true, "model_alias": "review-synthesis", "review_required": true },
      "reconcile": { "enabled": true, "model_alias": "review-synthesis" }
    }
  },
  "skills": {
    "template_root": "/projects/dev/agentops/templates/dispatch/skills",
    "selected": [
      "dispatch-plan",
      "dispatch-build",
      "dispatch-review",
      "code-change-verification",
      "backlog-refinement",
      "sprint-maintenance",
      "task-pickup",
      "plan-review",
      "sprint-resume",
      "sprint-packet",
      "item-done",
      "sprint-snapshot",
      "sprint-close",
      "capability-receipt",
      "verify-state-protocols",
      "reconcile-project-contracts"
    ],
    "overlays": [".agents/overlays/sprintctl.state-protocols.md"]
  },
  "scope": {
    "allowed_path_roots": ["sprintctl/", "tests/", "docs/", "verification/", ".agents/", "pyproject.toml"],
    "out_of_scope": ["shared sprint backends during concurrency or fault verification"]
  },
  "risk_surfaces": [
    {
      "id": "claim-ownership",
      "paths": ["sprintctl/db.py", "sprintctl/pg.py", "tests/test_claims.py", "tests/test_pg_integration.py"],
      "skills": ["verify-state-protocols", "reconcile-project-contracts"],
      "default_depth": 2,
      "required_on_change": true
    },
    {
      "id": "document-linked-work",
      "paths": ["sprintctl/cli.py", "docs/**"],
      "skills": ["reconcile-project-contracts"],
      "default_depth": 1,
      "required_on_change": false
    },
    {
      "id": "capability-receipt-lifecycle",
      "paths": [
        "sprintctl/contracts.py",
        "sprintctl/db.py",
        "sprintctl/pg.py",
        "sprintctl/cli.py",
        "tests/test_capability_receipts.py",
        "tests/test_pg_integration.py",
        "docs/reference/capability-receipts.md"
      ],
      "skills": ["verify-state-protocols", "reconcile-project-contracts"],
      "context_ids": ["sprintctl.capability-receipt.lifecycle"],
      "default_depth": 2,
      "required_on_change": true
    }
  ],
  "verification": {
    "command_families": ["unit", "integration", "docs", "full-suite"],
    "targeted_first": true,
    "commands": [
      "uv run pytest <specific-test-files> -x --tb=short",
      "python /projects/dev/agentops/templates/dispatch/scripts/validate_verification_artifacts.py --root ."
    ]
  },
  "hooks": {
    "level": "verification",
    "publishers": ["git", "dispatcher-gate"]
  }
}
